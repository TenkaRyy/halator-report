{
  "framework": "vite",
  "installCommand": "npm install --include=dev && cd server && npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**": {
      "includeFiles": "server/src/**,server/node_modules/**,server/package.json,server/tsconfig.json",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
